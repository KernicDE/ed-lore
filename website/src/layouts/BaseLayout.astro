---
import { t, type Lang } from '../i18n/dict';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  lang?: Lang;
}
const {
  title,
  description,
  ogImage = "/ed-lore/favicon.svg",
  canonical,
  lang = 'en',
} = Astro.props;

const baseUrl = "https://kernicde.github.io/ed-lore";
const canonicalUrl = canonical ? `${baseUrl}${canonical}` : baseUrl + Astro.url.pathname;
const finalTitle = title ?? t(lang, 'metaTitleDefault');
const finalDescription = description ?? t(lang, 'metaDescriptionDefault');
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{finalTitle}</title>
  <meta name="description" content={finalDescription} />
  <meta name="keywords" content="Elite Dangerous, GalNet, lore, timeline, ED, frontier, space simulation, galaxy, articles" />
  <meta name="author" content="ED Lore" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#080a0f" />
  <meta name="color-scheme" content="light dark" />
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('galnet-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#080a0f' : '#f5f7fa');

      const params = new URLSearchParams(window.location.search);
      const urlMode = params.get('ai');
      const storedAi = localStorage.getItem('galnet-ai-mode');
      const aiMode = urlMode === 'off' || urlMode === 'false' ? 'off'
                    : urlMode === 'on' || urlMode === 'true' ? 'on'
                    : storedAi || 'on';
      document.documentElement.setAttribute('data-ai-mode', aiMode);

      const storedLang = localStorage.getItem('galnet-lang');
      if (storedLang === 'en' || storedLang === 'de') {
        document.documentElement.setAttribute('data-lang', storedLang);
      } else {
        // No stored preference: derive from the page's own locale (e.g. /de/ routes)
        document.documentElement.setAttribute('data-lang', document.documentElement.lang === 'de' ? 'de' : 'en');
      }
    })();
  </script>
  
  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={finalTitle} />
  <meta property="og:description" content={finalDescription} />
  <meta property="og:image" content={`${baseUrl}${ogImage}`} />
  <meta property="og:site_name" content="ED Lore" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={finalTitle} />
  <meta name="twitter:description" content={finalDescription} />
  <meta name="twitter:image" content={`${baseUrl}${ogImage}`} />
  
  <!-- RSS / Atom Auto-discovery -->
  <link rel="alternate" type="application/rss+xml" title="ED Lore RSS (AI-enriched)" href={`${(import.meta.env.BASE_URL || '').replace(/\/$/, '')}/rss.xml`} />
  <link rel="alternate" type="application/atom+xml" title="ED Lore Atom (AI-enriched)" href={`${(import.meta.env.BASE_URL || '').replace(/\/$/, '')}/atom.xml`} />
  <link rel="alternate" type="application/rss+xml" title="ED Lore RSS (Raw)" href={`${(import.meta.env.BASE_URL || '').replace(/\/$/, '')}/rss-raw.xml`} />
  <link rel="alternate" type="application/atom+xml" title="ED Lore Atom (Raw)" href={`${(import.meta.env.BASE_URL || '').replace(/\/$/, '')}/atom-raw.xml`} />
  
  <!-- PWA -->
  <link rel="manifest" href={`${(import.meta.env.BASE_URL || '').replace(/\/$/, '')}/manifest.json`} />
  <link rel="icon" type="image/svg+xml" href={`${(import.meta.env.BASE_URL || '').replace(/\/$/, '')}/favicon.svg`} />
  <link rel="apple-touch-icon" href={`${(import.meta.env.BASE_URL || '').replace(/\/$/, '')}/favicon.svg`} />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&family=Exo+2:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ED Lore",
    "description": finalDescription,
    "url": baseUrl,
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${baseUrl}/?search={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  })} />
  
  <style is:global>
    @import "../styles/elite-hud.css";
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">{t(lang, 'skipLink')}</a>
  <div id="app-root">
    <slot />
  </div>
  
  <!-- Service Worker Registration -->
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/ed-lore/sw.js').catch(function(err) {
          console.log('SW registration failed:', err);
        });
      });
    }
  </script>
</body>
</html>
