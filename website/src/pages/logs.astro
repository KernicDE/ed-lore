---
import BaseLayout from '../layouts/BaseLayout.astro';
import graphData from '../data/lore_graph.json';
import SearchIsland from '../components/hud/SearchIsland';
import ThemeToggle from '../components/ThemeToggle.astro';
import AiModeToggle from '../components/AiModeToggle.astro';

const baseUrl = (import.meta.env.BASE_URL || '').replace(/\/$/, '');

const logs = graphData.articles
  .filter((a: any) => a.category === 'cmdr-log')
  .sort((a: any, b: any) => (b.date || '').localeCompare(a.date || ''));
---

<BaseLayout title="CMDR Logs — ED Lore">
  <header class="hud-header">
    <div>
      <a href={`${baseUrl}/`} style="text-decoration: none;" data-home-link>
        <span class="hud-title">‹ ED Lore</span>
      </a>
    </div>
    <div style="display: flex; align-items: center; gap: 12px;">
      <ThemeToggle />
      <AiModeToggle />
      <span class="ai-content-inline"><a href={`${baseUrl}/map/`} class="hud-search-btn hud-map-btn">◈ Map</a></span>
      <SearchIsland client:idle baseUrl={baseUrl} />
    </div>
  </header>

  <div style="padding: 24px; max-width: 900px; margin: 0 auto;">
    <div class="holo-panel" style="border-color: var(--elite-green-dim);">
      <h1 style="margin: 0; font-family: var(--font-hud); font-size: 24px; color: var(--elite-green);">
        CMDR Logs
      </h1>
      <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-dim); margin-top: 6px;">
        {logs.length} logs · Personal stories from the black
      </div>
    </div>

    {logs.length === 0 && (
      <div class="holo-panel">
        <div style="color: var(--text-dim); font-size: 13px;">No CMDR logs found yet. Be the first to submit one!</div>
      </div>
    )}

    <div class="holo-panel">
      {logs.map((art: any) => (
        <div style="padding: 10px 0; border-bottom: 1px solid var(--border-default);">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-dim);">{art.date}</span>
            {art.author && (
              <span style="font-family: var(--font-mono); font-size: 10px; color: var(--elite-green); border: 1px solid var(--elite-green-dim); padding: 1px 6px; opacity: 0.8;">
                {art.author}
              </span>
            )}
          </div>
          <a href={`${baseUrl}/?article=${art.uuid}`} style="font-size: 14px; font-weight: 500; color: var(--text-primary); text-decoration: none;">
            {art.title}
          </a>
          {art.summary && (
            <div class="ai-content" style="margin-top: 4px; font-size: 12px; color: var(--text-secondary); line-height: 1.4;">
              {art.summary}
            </div>
          )}
          {art.sources && art.sources.length > 0 && (
            <div style="margin-top: 4px; font-size: 11px;">
              <span style="color: var(--text-dim);">Source:</span>{' '}
              <a href={art.sources[0].url} target="_blank" rel="noopener" style="color: var(--elite-green); text-decoration: none;">
                {art.sources[0].name || 'Link'} ↗
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
